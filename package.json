{
  "name": "colors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build",
    "preview": "vite preview",
    "pages": "vite build && wrangler pages dev --port 8796",
    "deploy": "npm run build && wrangler pages deploy",
    "test": "node --test 'src/**/*.test.ts'",
    "fit": "uv run -q --no-project --with numpy python -I scripts/fit.py data src/core/params.ts",
    "shapes": "node scripts/shapes.mjs data/shapes src/shapes.ts",
    "names": "node scripts/names.mjs data/names public/colornames.txt",
    "test:browser": "playwright test",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/piazzolla": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
